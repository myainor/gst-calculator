{
  "name": "gst-calculator",
  "version": "1.0.0",
  "description": "A free, private GST calculator for India. Add or remove GST, see CGST, SGST and IGST, and get the amount in words. Runs entirely in your browser.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myainor/gst-calculator.git"
  },
  "homepage": "https://gst.freelysta.com",
  "bugs": "https://github.com/myainor/gst-calculator/issues",
  "keywords": [
    "gst",
    "gst-calculator",
    "india",
    "cgst",
    "sgst",
    "igst",
    "tax",
    "react",
    "vite",
    "freelancer"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
